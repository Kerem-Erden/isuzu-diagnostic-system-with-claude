# BENCH self-test profile (W15). VEHICLE MUST BE DISCONNECTED: this firmware drives CTX and transmits
# one self-test frame. Flash only with explicit permission; drive it with tools/bench_check.py.
CONFIG_ISUZU_GATEWAY_BENCH=y
CONFIG_ISUZU_CAN_BITRATE_500K=y
CONFIG_ISUZU_ECU_REQUEST_ID=0x7E0
CONFIG_ISUZU_TWAI_TX_GPIO=21
CONFIG_ISUZU_TWAI_RX_GPIO=22
